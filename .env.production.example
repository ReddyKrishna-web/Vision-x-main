# Vision-X Production Environment Configuration
# Copy to .env.production and fill in your actual values
# Never commit this file; keep real secrets in your deployment platform's secrets manager

# === REQUIRED ===
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=your-secure-admin-password-here
ADMIN_JWT_SECRET=your-admin-jwt-secret-min-32-chars-long
TEAM_JWT_SECRET=your-team-jwt-secret-min-32-chars-long

# === OPTIONAL: UI Customization ===
NEXT_PUBLIC_HACKATHON_NAME=VISION X 2026 HACKATHON

# === OPTIONAL: OCR (screenshot verification) ===
# If omitted, app uses built-in tesseract.js
OCRSPACE_API_KEY=

# === OPTIONAL: Email notifications (SMTP) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# === FRAUD DETECTION THRESHOLDS ===
FRAUD_AUTO_APPROVE_MAX_RISK=29
FRAUD_REVIEW_MIN_RISK=60
FRAUD_BLOCK_MIN_RISK=80

# === EXCEL SYNC ===
EXCEL_EXPORT_PATH=./data/vision-x-registrations.xlsx
EXCEL_SYNC_ENABLED=true
EXCEL_SYNC_MAX_RETRIES=5
EXCEL_STORAGE_PROVIDER=local
