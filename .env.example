# VISION X 2026 — copy to .env.local and fill in
ADMIN_EMAIL=admin@visionx.hack
ADMIN_PASSWORD=VisionX!2026
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
# Team dashboard sessions (falls back to ADMIN_JWT_SECRET when empty)
TEAM_JWT_SECRET=change-me-to-another-long-random-secret-min-32-chars
# Optional OCR: leave empty to use built-in tesseract.js; or set OCR.space key
OCRSPACE_API_KEY=
# Optional SMTP for confirmation emails (fails gracefully if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VISION X 2026 <no-reply@visionx.hack>"
# Public defaults (overridable from Admin Settings UI)
NEXT_PUBLIC_HACKATHON_NAME="VISION X 2026 HACKATHON"

# ---- Payments: Razorpay is the single active gateway ----
# Server-side only secrets — never prefix with NEXT_PUBLIC_, never commit real values.
# Use TEST keys (rzp_test_...) for development, LIVE keys only in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from the Razorpay Dashboard (required only if webhooks are enabled).
# Events URL to register: https://your-domain/api/payments/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ---- Fraud thresholds (risk score 0-100) ----
FRAUD_AUTO_APPROVE_MAX_RISK=29
FRAUD_REVIEW_MIN_RISK=60
FRAUD_BLOCK_MIN_RISK=80

# ---- Automatic Excel synchronization ----
EXCEL_EXPORT_PATH=./data/vision-x-registrations.xlsx
EXCEL_SYNC_ENABLED=true
EXCEL_SYNC_MAX_RETRIES=5
EXCEL_STORAGE_PROVIDER=local
# NOTE: on hosts with ephemeral disks, mount a persistent volume at ./data
# (SQLite DB, uploads, and the master workbook all live under ./data).
